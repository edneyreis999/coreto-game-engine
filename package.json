{
  "name": "coreto-game-engine-monorepo",
  "version": "0.1.0",
  "description": "Deterministic Time-to-Kill (TTK) validation system for RPG Maker MZ combat balancing - Monorepo Workspace",
  "author": "Coreto Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "rpg-maker-mz",
    "game-balance",
    "ttk",
    "simulation",
    "headless",
    "monorepo",
    "pnpm-workspace"
  ],
  "scripts": {
    "dev": "pnpm --filter @coreto/electron dev",
    "build": "pnpm --filter @coreto/core build && pnpm --filter @coreto/electron build",
    "type-check": "pnpm --filter @coreto/core type-check && pnpm --filter @coreto/electron type-check",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "test": "jest",
    "test:all": "pnpm --filter @coreto/core test && pnpm --filter @coreto/electron test && pnpm test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --selectProjects electron-e2e --no-coverage",
    "test:electron:e2e": "pnpm --filter @coreto/electron test:e2e",
    "clean": "pnpm --filter \"./packages/**\" clean && rm -rf node_modules pnpm-lock.yaml",
    "validate": "tsx scripts/validate-project.mts",
    "validate:architecture": "tsx scripts/validate-architecture.ts",
    "sample": "tsx examples/run-sample.ts"
  },
  "dependencies": {
    "jsdom": "^25.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "winston": "^3.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@oclif/core": "^4.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "chance": "^1.1.13",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-morph": "^23.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
