{
  "name": "coreto-game-engine",
  "version": "0.1.0",
  "description": "Deterministic Time-to-Kill (TTK) validation system for RPG Maker MZ combat balancing",
  "author": "Coreto Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "coreto-engine": "./bin/run.js"
  },
  "oclif": {
    "bin": "coreto-engine",
    "dirname": "coreto-engine",
    "commands": "./dist/cli/commands",
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Example hello world command"
      }
    }
  },
  "keywords": [
    "rpg-maker-mz",
    "game-balance",
    "ttk",
    "simulation",
    "headless"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "tsx scripts/validate-project.mts"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "cli-progress": "^3.12.0",
    "jsdom": "^25.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "winston": "^3.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
