{
  "name": "@coreto/core",
  "version": "3.0.0",
  "description": "Core game engine logic for TTK validation - shared between CLI and Electron apps",
  "author": "Coreto Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/index.test.d.ts",
      "import": "./dist/index.test.js",
      "default": "./dist/index.test.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jsdom": "^25.0.0",
    "reflect-metadata": "^0.2.2",
    "seedrandom": "^3.0.5",
    "tsyringe": "^4.8.0",
    "winston": "^3.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chance": "^1.1.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/seedrandom": "^3.0.8",
    "typescript": "^5.9.3"
  }
}
