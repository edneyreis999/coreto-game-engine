{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/renderer/**/*.d.ts",
    "src/renderer/src/types/**/*.d.ts",
    "tests/unit/renderer/**/*"
  ]
}
