{
  "name": "@coreto/electron",
  "version": "0.1.0",
  "description": "Electron Dev Portal for Coreto Game Engine",
  "author": "Coreto Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist out",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "predev": "pnpm rebuild:electron",
    "pretest": "pnpm rebuild:node",
    "test": "jest --config=../../jest.config.js --selectProjects electron-main --selectProjects electron-renderer --selectProjects electron-integration",
    "test:watch": "jest --config=../../jest.config.js --selectProjects electron-main --selectProjects electron-renderer --selectProjects electron-integration --watch",
    "test:main": "jest --config=../../jest.config.js --selectProjects electron-main",
    "test:renderer": "jest --config=../../jest.config.js --selectProjects electron-renderer",
    "test:integration": "jest --config=../../jest.config.js --selectProjects electron-integration",
    "test:e2e": "jest --config=../../jest.config.js --selectProjects electron-e2e",
    "pack:mac": "npm run build && electron-builder --mac --config electron-builder.config.js",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.js --publish never",
    "start:mac": "npm run pack:mac && open dist/mac/*.app"
  },
  "dependencies": {
    "@coreto/core": "workspace:*",
    "@radix-ui/react-slot": "^1.0.2",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "tailwind-merge": "^2.1.0",
    "tsyringe": "^4.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "33.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.3.6",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
